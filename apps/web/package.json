    "react-dom": "^19.2.0",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  }
}
